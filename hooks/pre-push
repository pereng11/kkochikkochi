#!/bin/sh
# KkochiKkochi 최종 경계 — git 이 직접 호출한다.
# KKOCHIKKOCHI-HOOK-v1  ← 자기 식별 마커. 설치기가 이 문자열로 "내 훅"을 판별한다.
#
# Stop 훅은 에이전트를 막지만 사람은 Esc 로 빠져나간다. 미검증 커밋이 남에게
# 넘어가는 것은 여기서 막는다.
#
# 여기서는 퀴즈를 내지 않는다 — push 는 보통 명령 하나이고 사람에게 묻는
# 채널이 없다. 거부하고 안내만 한다.
#
# jq 를 쓰지 않는다. 판정만 하고 아무것도 기록하지 않으므로 필요가 없고,
# jq 가 없는 환경에서 조용히 열리지 않아야 하는 유일한 층이다.
#
# ── D45 과의 긴장 ──────────────────────────────────────────────
# "지금 검증해야 할 것은 scripts/pending.sh 가, 그리고 오직 거기서만
# 정한다"(D45)는 Task 4-6 이 끝까지 지켰다. 이 훅은 그럴 수 없다 — 설치된
# 사본은 플러그인으로 돌아가는 경로가 전혀 없어(hooks/ 아래에서 scripts/를
# 부르지 않는다) pending.sh 를 부를 수 없다. 그래서 git 과 covered.tsv 로
# 같은 답을 여기서 직접 다시 계산한다.
#
# 그 중복은 구조적으로 강제된 것이니 최대한 작고 눈에 띄게 남겨 둔다.
# 아래 diff-tree 호출의 정확한 철자
# (`--raw -z --abbrev=40 --no-renames`, blob sha 를 4번째 필드로 읽는 것,
# covered.tsv 의 `<blob_sha>\t<path>\t<pass_id>` 3열 규칙과 비교하는 방식)가
# covered.tsv 를 쓰는 record-pass.sh·읽는 hooks/pre-commit 과 반드시 같아야
# 한다. 커버리지 규칙이 바뀌면(D45) 이 세 곳을 같이 고쳐야 한다.

set -u

CHAINED="$(git rev-parse --git-path hooks)/pre-push.kkochikkochi-chained"

# ── 체이닝된 기존 훅을 먼저 실행한다 ──────────────────────────────
# 자기 재귀 가드: 체이닝 파일 자체가 우리 훅의 사본이면 실행하지 않는다.
# 그 파일도 같은 방식으로 체이닝 경로를 계산해 자기 자신을 다시 부른다.
#
# stdin 은 한 번만 읽을 수 있으므로 아래 QDIR 판정 루프가 쓰기 전에 먼저
# 전부 담아 두고 체이닝된 훅과 이 훅의 루프 양쪽에 나눠 준다.
push_refs="$(cat)"

if [ -x "$CHAINED" ] && ! grep -q 'KKOCHIKKOCHI-HOOK-v1' "$CHAINED" 2>/dev/null; then
  printf '%s\n' "$push_refs" | "$CHAINED" "$@" || exit $?
fi

QDIR="$(git rev-parse --git-common-dir)/quiz-gate"
COVERED="$QDIR/covered.tsv"

NULL_SHA=0000000000000000000000000000000000000000

blocked=""

# stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  # 브랜치 삭제 — 넘어가는 내용이 없다.
  [ "$local_sha" = "$NULL_SHA" ] && continue

  # local_sha/remote_sha 형식을 검증한다. 정상 경로에서 이 값은 git 자신이
  # 채우므로 항상 16진수(또는 전부 0)이지만, 바로 아래에서 $range 를 단어
  # 분리해 그대로 git rev-list 인자로 넘긴다 — 검증 없이 그러면 값이
  # "-" 로 시작할 때 git 이 그것을 실제 SHA 대신 옵션으로 오인할 수 있다.
  # 16진수가 아닌 값은(대시로 시작하는 값도 여기 걸린다) 신뢰할 수 없는
  # 입력으로 보고 거부한다 — 이 훅은 최종 경계이므로 애매하면 막는다.
  case "$local_sha" in
    ''|*[!0-9a-fA-F]*)
      blocked="$blocked   (알 수 없는 local sha 형식: $local_sha)
"
      continue
      ;;
  esac
  case "$remote_sha" in
    ''|*[!0-9a-fA-F]*)
      blocked="$blocked   (알 수 없는 remote sha 형식: $remote_sha)
"
      continue
      ;;
  esac

  if [ "$remote_sha" = "$NULL_SHA" ]; then
    # 새 브랜치다. 이미 리모트에 있는 것을 빼고 이 브랜치에만 있는 것을 본다.
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  # 각 커밋의 (blob sha, 경로) 를 covered.tsv 와 대조한다. 철자는
  # covered.tsv 를 쓴 쪽과 반드시 같아야 한다 — -z 로 받아 아무것도
  # 따옴표로 감싸지 않는다.
  # shellcheck disable=SC2046,SC2086  # range·rev-list 출력 모두 단어 분리가 목적이다
  for commit in $(git rev-list $range 2>/dev/null); do
    # meta 줄의 생김새를 매 짝마다 검사한다(hooks/pre-commit 과 같은 검사).
    # 경로에 진짜 개행 바이트가 있으면 NR%2 짝짓기가 밀리고, 밀린 뒤의
    # 파일들은 이 훅의 시야에서 통째로 사라져 검증 없이 push 를 통과한다.
    # hooks/pre-commit 은 이 상황에서 fail-open 한다(D42) — 이해와 무관한
    # 이유로 커밋을 영구히 막지 않기 위해서다. 여기서는 반대로
    # **fail-closed** 한다: 이 훅은 최종 경계이고, 조용히 열리면 그 자체가
    # 보안 구멍이다. push 하나가 막히는 편이 남의 저장소로 미검증 변경이
    # 새는 것보다 낫다.
    if ! pairs="$(git -c core.quotePath=false diff-tree --no-commit-id --root \
               --raw -z --abbrev=40 --no-renames "$commit" 2>/dev/null \
             | tr '\0' '\n' \
             | awk '
        function is_meta(s,   n, a) {
          if (substr(s, 1, 1) != ":") return 0
          n = split(s, a, " ")
          if (n != 5) return 0
          if (length(a[1]) != 7) return 0
          if (length(a[3]) != 40 || length(a[4]) != 40) return 0
          if (a[3] ~ /[^0-9a-f]/ || a[4] ~ /[^0-9a-f]/) return 0
          return 1
        }
        NR % 2 { if (!is_meta($0)) exit 1; split($0, f, " "); sha = f[4]; next }
               { printf "%s\t%s\n", sha, $0 }
        END    { if (NR % 2) exit 1 }
      ')"; then
      blocked="$blocked   (커밋 $commit 의 경로 목록을 해석할 수 없습니다 — 개행 문자가 든 경로가 있을 수 있습니다)
"
      continue
    fi
    [ -n "$pairs" ] || continue

    while IFS='	' read -r sha path; do
      [ -n "$sha" ] || continue
      [ "$sha" = "$NULL_SHA" ] && continue   # 삭제된 파일
      if [ -r "$COVERED" ] && KK_PATH="$path" awk -F'\t' -v s="$sha" \
           '$1 == s && $2 == ENVIRON["KK_PATH"] { found = 1; exit }
            END { exit !found }' "$COVERED"; then
        continue
      fi
      case "$blocked" in
        *"   $path
"*) ;;
        *) blocked="$blocked   $path
" ;;
      esac
    done <<PAIRS
$pairs
PAIRS
  done
done <<PUSH_REFS
$push_refs
PUSH_REFS

[ -n "$blocked" ] || exit 0

cat >&2 <<MSG
🦡 KkochiKkochi — push 하려는 커밋에 검증되지 않은 변경이 있습니다.

$blocked
kkochikkochi 스킬을 실행해 퀴즈를 통과한 뒤 다시 push 하세요.
MSG
exit 1
