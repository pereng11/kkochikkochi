#!/bin/sh
# KkochiKkochi 최종 경계 — git 이 직접 호출한다.
# KKOCHIKKOCHI-HOOK-v1  ← 자기 식별 마커. 설치기가 이 문자열로 "내 훅"을 판별한다.
#
# Stop 훅은 에이전트를 막지만 사람은 Esc 로 빠져나간다. 미검증 커밋이 남에게
# 넘어가는 것은 여기서 막는다.
#
# 여기서는 퀴즈를 내지 않는다 — push 는 보통 명령 하나이고 사람에게 묻는
# 채널이 없다. 거부하고 안내만 한다.
#
# jq 를 쓰지 않는다. 판정만 하고 아무것도 기록하지 않으므로 필요가 없고,
# jq 가 없는 환경에서 조용히 열리지 않아야 하는 유일한 층이다.
#
# ── D45 과의 긴장 ──────────────────────────────────────────────
# "지금 검증해야 할 것은 scripts/pending.sh 가, 그리고 오직 거기서만
# 정한다"(D45)는 Task 4-6 이 끝까지 지켰다. 이 훅은 그럴 수 없다 — 설치된
# 사본은 플러그인으로 돌아가는 경로가 전혀 없어(hooks/ 아래에서 scripts/를
# 부르지 않는다) pending.sh 를 부를 수 없다. 그래서 git 과 covered.tsv 로
# 같은 답을 여기서 직접 다시 계산한다.
#
# 그 중복은 구조적으로 강제된 것이니 최대한 작고 눈에 띄게 남겨 둔다.
# 아래 diff-tree 호출의 정확한 철자
# (`--raw -z --abbrev=40 --no-renames`, blob sha 를 "결과" sha 필드로 읽는 것,
# covered.tsv 의 `<blob_sha>\t<path>\t<pass_id>` 3열 규칙과 비교하는 방식)가
# covered.tsv 를 쓰는 record-pass.sh·읽는 hooks/pre-commit 과 반드시 같아야
# 한다. 커버리지 규칙이 바뀌면(D45) 이 세 곳을 같이 고쳐야 한다.
#
# ── 검사 범위 (D47) ────────────────────────────────────────────
# 이 훅은 "사용자가 에이전트로 작업한 코드"만 본다. push 범위에서 두 가지를
# 뺀다: 어느 리모트 추적 ref 에서든 도달 가능한 커밋(git pull 로 들어온 남의
# 커밋, 브랜치 분기점, clone 해 온 이력)과, 게이트 설치 시점(epoch)의 ref
# 팁에서 도달 가능한 커밋(git init 직후의 이력).
#
# 빠지지 않는 것: cherry-pick·squash 로 가져온 남의 커밋. 새 SHA 라 도달성
# 판정에 안 걸린다. 교착은 아니다 — 막히면 퀴즈로 풀린다.
#
# 이 두 제외는 이 훅이 신뢰하는 입력의 범위를 넓힌다: `refs/remotes/` 아래의
# 모든 ref 와 `epoch` 파일의 모든 줄이 이제 "무엇을 검사할지"를 좌우한다.
# `git update-ref refs/remotes/x/y <sha>` 나 epoch 에 현재 HEAD 를 한 줄
# 적어 넣는 것만으로 그 범위가 조용히 통과로 뒤집힌다(실측 확인) — 둘 다
# `passes/` 에 흔적을 남기지 않는다. 신뢰 경계는 보안이 아니라 규율
# 장치라는 이 프로젝트의 원칙(README "한계")대로, 이 확장도 사후 감사에
# 맡긴다.
#
# ── 리뷰에서 걸린 두 개의 fail-open 구멍 ──────────────────────────
# 이 훅은 "이 층은 fail-closed 다"라고 스스로 선언해 놓고 실제로는 두 군데서
# 조용히 열려 있었다(리뷰가 실제 push 로 재현):
#   1) 병합 커밋. `diff-tree --raw`는 `-m`/`-c`/`--cc` 없이는 병합 커밋에
#      대해 아무것도 내지 않는다 — 그래서 충돌 해소로 새로 생긴 내용이(그
#      어느 parent 에도 없던 내용이) 검증 없이 그대로 새 나갔다. 아래에서
#      `--cc`(결합 diff)를 추가해 "어느 parent 로도 설명되지 않는" 내용만
#      정확히 잡아낸다 — 자동으로 병합된(어느 한쪽 parent 와 동일한) 파일은
#      그 parent 를 만든 원래 커밋에서 이미 검사됐으므로 여기서 또 볼 필요가
#      없다.
#   2) `git rev-list` 실패. `for commit in $(git rev-list $range 2>/dev/null)`
#      처럼 명령 치환을 `for...in` 안에 직접 넣으면 종료 코드가 사라진다 —
#      범위를 하나도 못 봤다는 사실이 "커밋 없음"과 구별되지 않는다(실측:
#      동료가 push 한 뒤 fetch 안 하고 rebase, force-push 하는 흔한 흐름에서
#      `remote_sha` 객체가 로컬에 없어 rev-list 가 128 로 죽는다). 아래에서
#      먼저 변수에 담아 종료 코드를 직접 검사한다.

set -u

CHAINED="$(git rev-parse --git-path hooks)/pre-push.kkochikkochi-chained"

# ── 체이닝된 기존 훅을 먼저 실행한다 ──────────────────────────────
# 자기 재귀 가드: 체이닝 파일 자체가 우리 훅의 사본이면 실행하지 않는다.
# 그 파일도 같은 방식으로 체이닝 경로를 계산해 자기 자신을 다시 부른다.
#
# stdin 은 한 번만 읽을 수 있으므로 아래 QDIR 판정 루프가 쓰기 전에 먼저
# 전부 담아 두고 체이닝된 훅과 이 훅의 루프 양쪽에 나눠 준다.
push_refs="$(cat)"

if [ -x "$CHAINED" ] && ! grep -q 'KKOCHIKKOCHI-HOOK-v1' "$CHAINED" 2>/dev/null; then
  printf '%s\n' "$push_refs" | "$CHAINED" "$@" || exit $?
fi

QDIR="$(git rev-parse --git-common-dir)/quiz-gate"
COVERED="$QDIR/covered.tsv"

# 전부 '0'인지만 본다 — 길이는 보지 않는다. sha1 저장소의 null sha 는
# 40자리 0 이지만 SHA-256 저장소는 64자리 0 이다(실측: `git init
# --object-format=sha256` 로 만든 저장소에서 새 브랜치를 push 하면 pre-push
# stdin 의 remote sha 가 정확히 64개의 0으로 온다). 예전처럼 40자리 0 상수와
# 문자열 비교하면 SHA-256 저장소에서는 "새 브랜치"·"브랜치 삭제" 판별이
# 전부 어긋나 범위 계산이 항상 깨진다 — 그리고 rev-list 실패를 fail-closed
# 로 바꾼 지금은, 그 오판이 "게이트가 열린다"가 아니라 "정상적인 첫 push
# 까지 전부 막힌다"로 나타난다. 둘 다 틀렸으니 길이에 의존하지 않는다.
is_null_sha() {
  case "$1" in
    ''|*[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

blocked=""       # 내용이 미검증인 (sha, 경로) — 대개 kkochikkochi 스킬로 풀린다.
                 # 다만 전부는 아니다: ledger 도 staged diff 도 거친 적 없는
                 # 채로 이력에 들어온 커밋(가장 큰 예: 사람이 직접 만든
                 # 커밋 — README 한계 표)은 pending.sh 자체가 "검증할 것
                 # 없음"으로 답해 퀴즈가 성립하지 않는다. 그래서 이 범주의
                 # 메시지도 --no-verify(그리고 git fetch)를 함께 안내한다
                 # (아래 메시지 조립부 참고) — unparseable 과 문구는 다르되
                 # 탈출구 없이 영구히 막히지 않는다는 성질(D42)은 같다.
unparseable=""   # 범위·스트림을 판정할 수 없어 막은 것 — 어떤 퀴즈로도 못 푼다.
                 # D00/D42 가 금지하는 "이해와 무관한 이유로 영구히 막힘"이
                 # 되지 않으려면, 이 범주는 반드시 --no-verify 탈출구를
                 # 메시지에 남겨야 한다(아래 메시지 조립부 참고).

EPOCH="$QDIR/epoch"

# epoch — 게이트가 이 저장소에 설치될 때 이미 존재하던 ref 팁 (D47).
# 그보다 앞선 이력은 이 게이트가 볼 수 있었던 적이 없으므로 검사하지 않는다.
#
# **살아 있고 16진수인 줄만 쓴다.** 실측: 없는 객체 하나를 --not 에 주면
# rev-list 가 128 로 죽고(cat-file -e 는 1), 이 훅은 fail-closed 라 그
# 순간 저장소의 모든 push 가 어떤 퀴즈로도 못 푸는 채로 영구 차단된다 —
# D00/D42 가 금지하는 바로 그 모양이다. 브랜치 삭제·GC 로 실제로 일어난다.
# 줄을 버리는 것은 안전 방향으로만 틀린다: 덜 빼면 더 많이 검사한다.
#
# 16진수 검사는 인자 주입 방어를 겸한다. epoch 은 파일에서 온 값이고
# 아래에서 $range 가 단어 분리를 거치므로, "--all" 같은 진짜 rev-list
# 옵션이 섞이면 범위가 통째로 바뀐다. 이 필터는 반드시 배치 존재-확인보다
# 먼저, 이 셸 루프 안에서 걸려야 한다 — 아래 cat-file --batch-check 는
# stdin 에 온 것을 그대로 조회할 뿐 옵션처럼 보이는 줄을 막지 않는다.
epoch_args=""
if [ -e "$EPOCH" ]; then
  if [ -r "$EPOCH" ]; then
    hex_lines=""
    while IFS= read -r epoch_line; do
      [ -n "$epoch_line" ] || continue
      case "$epoch_line" in
        *[!0-9a-fA-F]*)
          echo "kkochikkochi: 경고 — epoch 의 16진수 아닌 줄을 무시합니다: $epoch_line" >&2
          continue
          ;;
      esac
      hex_lines="$hex_lines$epoch_line
"
    done < "$EPOCH"

    # 존재 확인은 살아남은 16진수 줄 전체를 한 번에 batch-check 로 묻는다.
    # 줄마다 `git cat-file -e` 를 새 프로세스로 fork 하면 epoch 줄 수에
    # 선형으로 비례해 push 마다 비용이 든다(실측: 800줄에서 6.5초 vs
    # 배치 0.05초 — install.sh 가 refs/heads·refs/tags·refs/remotes 팁을
    # 전부 적으므로 태그·리모트 브랜치가 많은 저장소에서는 흔한 규모다).
    # `--batch-check` 는 존재하는 객체에 한해서만 지정한 포맷을 낸다.
    # 못 찾으면 포맷을 무시하고 "<입력> missing" 한 줄을 내지만, 그게
    # 유일한 실패 형태가 아니다 — 짧게 줄인 16진수가 여러 객체와 동시에
    # 맞으면 "<입력> ambiguous" 를 낸다(실측). 예전 코드는 $2 != "missing"
    # 로 존재를 판정했는데, ambiguous 줄은 그 조건을 통과해 $1(입력값 그대로,
    # 진짜 객체 이름이 아니다)이 epoch_args 에 실렸다 — 그 값이 그대로
    # `git rev-list --not` 인자로 가면 rev-list 가 128 로 죽어 fail-closed
    # 경로가 모든 push 를 영구 차단한다(다른 어떤 --not 대상 없는 사유와
    # 달리 이건 퀴즈로도 못 푼다). missing·ambiguous 둘 다 잡으려고
    # 블랙리스트를 계속 늘리는 대신, 알려진 객체 타입 4종(commit·tag·tree·
    # blob)만 화이트리스트로 통과시킨다 — batch-check 가 낼 수 있는 실패
    # 상태를 전부 몰라도(새 상태가 앞으로 늘어도) 안전한 쪽으로만 틀린다.
    if [ -n "$hex_lines" ]; then
      epoch_args="$(printf '%s' "$hex_lines" \
        | git cat-file --batch-check='%(objectname) %(objecttype)' 2>/dev/null \
        | awk '
            $2 == "commit" || $2 == "tag" || $2 == "tree" || $2 == "blob" {
              printf " %s", $1
              next
            }
            { print "kkochikkochi: 경고 — epoch 의 사라진 객체를 무시합니다: " $1 > "/dev/stderr" }
          ')"
    fi
  else
    # 있는데 못 읽는다. 이 층은 fail-closed 지만, 못 뺀 이력은 어떤 퀴즈로도
    # covered.tsv 에 넣을 수 없으므로(pending.sh 는 staged 만 본다) 반드시
    # --no-verify 탈출구가 있는 unparseable 범주로 보낸다.
    unparseable="$unparseable   (epoch 파일을 읽을 수 없습니다: $EPOCH)
"
  fi
fi

# stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -n "${local_sha:-}" ] || continue

  # local_sha 형식을 검증한다(remote_sha 는 더 이상 범위 계산에 쓰지 않으므로
  # 검증하지 않는다 — D47). 정상 경로에서 이 값은 git 자신이 채우므로 항상
  # 16진수(또는 전부 0)이지만, 바로 아래에서 $range 를 단어 분리해 그대로
  # git rev-list 인자로 넘긴다 — 검증 없이 그러면 값이 "-" 로 시작할 때 git
  # 이 그것을 실제 SHA 대신 옵션으로 오인할 수 있다. 16진수가 아닌 값은
  # (대시로 시작하는 값도 여기 걸린다) 신뢰할 수 없는 입력으로 보고 거부한다
  # — 이 훅은 최종 경계이므로 애매하면 막는다. 이건 퀴즈로 풀 수 있는 사유가
  # 아니므로 unparseable 로 쌓는다.
  case "$local_sha" in
    ''|*[!0-9a-fA-F]*)
      unparseable="$unparseable   (알 수 없는 local sha 형식: $local_sha)
"
      continue
      ;;
  esac
  # 브랜치 삭제 — 넘어가는 내용이 없다.
  is_null_sha "$local_sha" && continue

  # remote_sha 는 범위 계산에 쓰지 않는다 (D47).
  #
  # 예전에는 새 브랜치면 `--not --remotes`, 아니면 `$remote_sha..$local_sha`
  # 로 갈렸다. 후자가 구멍이었다: feature 브랜치를 올려 둔 뒤 git pull 로
  # 들어온 남의 커밋이 전부 그 범위에 들어와 검사 대상이 됐다(실측 재현).
  #
  # 로컬의 리모트 추적 ref 로 갈아타는 것은 안전 방향으로만 틀린다 —
  # 추적 ref 가 stale 하면 덜 빼서 더 많이 검사하고, 앞서 있으면 그 부분은
  # 애초에 이 push 범위 밖이다. 새 브랜치 경로가 이미 쓰던 방식이라
  # 두 경로의 규칙이 같아지는 것이 덤이다.
  #
  # --not 하나가 --remotes 와 뒤따르는 epoch sha 전부에 적용된다(실측).
  range="$local_sha --not --remotes$epoch_args"

  # rev-list 를 먼저 변수에 담아 종료 코드를 직접 검사한다. `for commit in
  # $(git rev-list $range)` 처럼 명령 치환을 for 문에 바로 넣으면 실패해도
  # 종료 코드가 사라지고 word-split 결과가 그냥 빈 목록이 되어 "이 범위엔
  # 미검증 커밋이 없다"와 똑같이 보인다 — 그 범위를 하나도 못 본 것과 정말
  # 아무것도 없는 것은 다르다. 실패하면(원격에서 온 sha 를 로컬이 모르는
  # rebase+force-push 흐름 등) 그 범위는 판정 불가로 막는다 — 이 훅은
  # fail-closed 여야 한다.
  # shellcheck disable=SC2046,SC2086  # range·rev-list 출력 모두 단어 분리가 목적이다
  if ! commits="$(git rev-list $range 2>/dev/null)"; then
    unparseable="$unparseable   (범위를 계산할 수 없습니다: $range)
"
    continue
  fi

  # 각 커밋의 (blob sha, 경로) 를 covered.tsv 와 대조한다. 철자는
  # covered.tsv 를 쓴 쪽과 반드시 같아야 한다 — -z 로 받아 아무것도
  # 따옴표로 감싸지 않는다.
  #
  # --cc(결합 diff)를 반드시 붙인다. 실측: 병합이 아닌 커밋·루트 커밋에는
  # --cc 가 있어도 없어도 출력이 완전히 같다(그래서 매 커밋마다 부모 수를
  # 미리 알아내는 별도 호출이 필요 없다) — 반면 병합 커밋에는 --cc 없이는
  # 아무것도 나오지 않는다. --cc 는 "모든 parent 로부터 설명되지 않는"
  # 파일만 낸다 — 자동 병합된(한쪽 parent 와 완전히 같은) 파일은 그 parent
  # 를 만든 원래 커밋에서 이미 검사되므로 빠지는 게 맞고, 진짜 충돌 해소로
  # 새로 만들어진 내용만 여기 남는다.
  # shellcheck disable=SC2086  # commits 는 줄마다 하나씩 단어 분리가 목적이다
  for commit in $commits; do
    # meta 줄의 생김새를 매 짝마다 검사한다(hooks/pre-commit 과 같은 검사를
    # N-parent 결합 diff 로 일반화한 것). 경로에 진짜 개행 바이트가 있으면
    # NR%2 짝짓기가 밀리고, 밀린 뒤의 파일들은 이 훅의 시야에서 통째로
    # 사라져 검증 없이 push 를 통과한다. hooks/pre-commit 은 이 상황에서
    # fail-open 한다(D42) — 이해와 무관한 이유로 커밋을 영구히 막지 않기
    # 위해서다. 여기서는 반대로 **fail-closed** 한다: 이 훅은 최종 경계이고,
    # 조용히 열리면 그 자체가 보안 구멍이다. push 하나가 막히는 편이 남의
    # 저장소로 미검증 변경이 새는 것보다 낫다 — 단, 퀴즈로 풀 수 없는
    # 사유이므로 unparseable 로 쌓아 메시지에 --no-verify 탈출구를 남긴다.
    if ! pairs="$(git -c core.quotePath=false diff-tree --no-commit-id --root \
               --raw -z --abbrev=40 --no-renames --cc "$commit" 2>/dev/null \
             | tr '\0' '\n' \
             | awk '
        # 결합(combined) raw 포맷은 부모 수(N)에 따라 필드 수가 늘어난다:
        # 선행 콜론 N개, (N개의 parent 모드 + 결과 모드) = N+1개 모드 필드,
        # (N개의 parent sha + 결과 sha) = N+1개 sha 필드, 상태 문자 N개를
        # 이어붙인 필드 1개. 병합이 아닌 보통 커밋은 N=1 인 경우와 같은
        # 식이라(":<mode-old> <mode-new> <sha-old> <sha-new> <status>")
        # 별도 분기 없이 이 하나의 함수로 둘 다 검증한다. 마지막 sha 필드
        # (2N+2번째)가 "결과" blob — 병합 결과물이든 보통 커밋의 새 내용이든
        # covered.tsv 와 비교해야 할 바로 그 sha 다.
        function is_meta(s,   n, a, ncolons, i, mode1) {
          if (substr(s, 1, 1) != ":") return 0
          n = split(s, a, " ")
          ncolons = 0
          while (substr(a[1], ncolons + 1, 1) == ":") ncolons++
          if (ncolons < 1) return 0
          if (n != 2 * ncolons + 3) return 0
          mode1 = substr(a[1], ncolons + 1)
          if (length(mode1) != 6 || mode1 ~ /[^0-9]/) return 0
          for (i = 2; i <= ncolons + 1; i++) {
            if (length(a[i]) != 6 || a[i] ~ /[^0-9]/) return 0
          }
          for (i = ncolons + 2; i <= 2 * ncolons + 2; i++) {
            if (length(a[i]) != 40 || a[i] ~ /[^0-9a-f]/) return 0
          }
          if (length(a[2 * ncolons + 3]) != ncolons) return 0
          sha = a[2 * ncolons + 2]
          return 1
        }
        NR % 2 { if (!is_meta($0)) exit 1; next }
               { printf "%s\t%s\n", sha, $0 }
        END    { if (NR % 2) exit 1 }
      ')"; then
      unparseable="$unparseable   (커밋 $commit 의 경로 목록을 해석할 수 없습니다 — 개행 문자가 든 경로가 있을 수 있습니다)
"
      continue
    fi
    [ -n "$pairs" ] || continue

    while IFS='	' read -r sha path; do
      [ -n "$sha" ] || continue
      is_null_sha "$sha" && continue   # 삭제된 파일
      if [ -r "$COVERED" ] && KK_PATH="$path" awk -F'\t' -v s="$sha" \
           '$1 == s && $2 == ENVIRON["KK_PATH"] { found = 1; exit }
            END { exit !found }' "$COVERED"; then
        continue
      fi
      case "$blocked" in
        *"   $path
"*) ;;
        *) blocked="$blocked   $path
" ;;
      esac
    done <<PAIRS
$pairs
PAIRS
  done
done <<PUSH_REFS
$push_refs
PUSH_REFS

[ -n "$blocked" ] || [ -n "$unparseable" ] || exit 0

# blocked(내용 미검증)와 unparseable(판정 불가)를 다른 안내로 나눈다.
# unparseable 은 covered.tsv 를 아무리 채워도 절대 못 푼다 — pending.sh 도
# 같은 스트림을 형식 오류(exit 2)로 거부하므로 그 경로는 어떤 퀴즈로도
# "검증됨"이 될 수 없다(리뷰가 실제로 시도해 확인했다). 그런 사유로 영구히
# push 를 못 하게 두는 것은 D00/D42 가 금지하는 것과 정확히 같은 모양이므로,
# 이 범주는 반드시 우회 방법(--no-verify)을 메시지에 남긴다.
{
  echo "🦡 KkochiKkochi — push 하려는 커밋에 검증되지 않은 변경이 있습니다."

  if [ -n "$blocked" ]; then
    echo
    printf '%s' "$blocked"
    echo
    echo "먼저 kkochikkochi 스킬을 실행해 퀴즈를 통과한 뒤 다시 push 하세요."
    echo
    # blocked 는 "퀴즈로 풀 수 있는 것"과 "리더·pending.sh 어느 쪽으로도
    # 검증 대상을 계산할 수 없는 것"(가장 큰 예: 사람이 직접 만든 커밋 —
    # README 한계 표에 문서화돼 있다)을 함께 담는다. 퀴즈를 냈는데
    # pending.sh 가 "검증할 것이 없다"고 답하면 바로 그 경우다 — 그때 여기
    # 서 있는 사람이 볼 수 있는 것은 이 안내뿐이므로, unparseable 의 탈출구를
    # 여기서도 반복한다(D42): 스킬로 퀴즈를 내는 것이 여전히 첫 번째 시도이고,
    # 아래는 그것이 아무것도 계산해내지 못했을 때를 위한 것이다.
    echo "스킬을 실행했는데 검증할 대상이 없다고 답한다면(예: 사람이 직접 만든 커밋), 이 안내로는 풀 수 없다는 뜻입니다 — 다음을 시도하세요:"
    echo "  - 로컬의 추적 ref 가 오래됐을 수 있습니다: git fetch 후 다시 push 하세요."
    echo "  - 그래도 막히면 최후 수단으로 사용자가 직접 'git push --no-verify' 를 실행하세요 (에이전트의 시도는 이 저장소의 에이전트 훅이 거부합니다)."
  fi

  if [ -n "$unparseable" ]; then
    echo
    echo "다음은 이 훅이 판정할 수 없어 막았습니다 — 어떤 퀴즈로도 풀 수 없습니다:"
    printf '%s' "$unparseable"
    echo
    echo "직접 검토했다면 사용자가 'git push --no-verify' 로 이 검사를 건너뛰고 push 하세요 (에이전트의 시도는 거부됩니다)."
  fi
} >&2
exit 1
